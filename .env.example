# Valoxi environment variables. Copy to .env and fill in. Never commit .env.
# Source of truth: docs/do-migration/assessment.md section 3.
# Values live in the password manager and in DO encrypted env vars, not in this repo.

# --- Core ---
NODE_ENV=
PORT=
APP_URL=
SESSION_SECRET=
MARKETING_SITE_URL=
ISSUE_REPORT_RECIPIENT=

# --- Database (Neon). App uses the pooled URL; pg_dump / pg_restore use the direct URL ---
DATABASE_URL=

# --- Clerk. VITE_ key is inlined at build time, so it must exist during `npm run build` ---
CLERK_ENABLED=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Gemini ---
GOOGLE_GEMINI_API_KEY=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
RESEND_API_KEY_MARKETING=
RESEND_MARKETING_FROM_ADDRESS=
RESEND_WEBHOOK_SECRET=
RESEND_SEGMENT_ACTIVE_SUBSCRIBERS=
RESEND_SEGMENT_ALL_USERS=
RESEND_SEGMENT_CANCELLED_SUBSCRIBERS=
RESEND_SEGMENT_PAST_DUE=
RESEND_SEGMENT_TEST_INTERNAL=
RESEND_SEGMENT_TRIALING=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_ALERT_EMAIL=

# --- Nylas ---
NYLAS_API_KEY=
NYLAS_API_URI=
NYLAS_CLIENT_ID=
NYLAS_REDIRECT_URI=
NYLAS_STATE_SECRET=
NYLAS_CONNECT_GMAIL_VISIBLE=
NYLAS_CONNECT_OUTLOOK_VISIBLE=

# --- Billing and internal ---
FIVE_D_BILLING_START=
TEST_INTERNAL_USER_COMPANY_ID=

# --- PDF generation (set in the Docker image; leave empty locally to use bundled Chromium) ---
PUPPETEER_EXECUTABLE_PATH=

# --- Local inspection only. Not set on DO. Leave unset until plan phase 7 ---
PROD_DATABASE_URL=
